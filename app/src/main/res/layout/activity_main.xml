<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090F"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_wifi_sleep_timer"
        android:textColor="#ECEFF6"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:fontFamily="monospace"
        android:text="15:00"
        android:textColor="#FFB74D"
        android:textSize="64sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn5Min"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#171E2E"
            android:text="@string/preset_5_min"
            android:textColor="#ECEFF6" />

        <Button
            android:id="@+id/btn10Min"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#171E2E"
            android:text="@string/preset_10_min"
            android:textColor="#ECEFF6" />

        <Button
            android:id="@+id/btn15Min"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#171E2E"
            android:text="@string/preset_15_min"
            android:textColor="#ECEFF6" />

        <Button
            android:id="@+id/btn30Min"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#171E2E"
            android:text="@string/preset_30_min"
            android:textColor="#ECEFF6" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConfirmStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#FFB74D"
        android:text="@string/button_confirm_start"
        android:textColor="#07090F"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
